OPENROUTER_API_KEY=your-openrouter-key-here
TAVILY_API_KEY=your-tavily-key-here

# Shared server-to-server credential. Configure the same strong random value in
# Vercel and Render. Never prefix it with VITE_ or expose it to browser code.
GRADUSIQ_PROXY_SECRET=replace-with-a-strong-random-secret

# Render backend configuration. CORS is browser policy, not authentication.
GRADUSIQ_ALLOWED_ORIGINS=http://localhost:5173
GRADUSIQ_RATE_LIMIT_REQUESTS=10
GRADUSIQ_RATE_LIMIT_WINDOW_SECONDS=60
GRADUSIQ_MAX_CONCURRENT_AI_REQUESTS=2

# Vercel server-side function only. Production should use the HTTPS Render URL.
GRADUSIQ_BACKEND_URL=http://localhost:8000

# Required by the backend's session-scoped /me routes: GradusIQ_career/
# supabase_client.py's _required_env raises if either is unset, which every
# /api/v2/student/me/* request then returns as a 503 at request time.
# The publishable (anon) key only -- never the secret/service-role key, which
# would bypass RLS. Set both in Render as well; see README.md.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Bug/feature report pop-up (POST /api/v2/student/me/feedback). Backend only.
# Without the key the route returns 503 and the pop-up tells students to email
# the team directly. The From address's domain must be verified in Resend.
RESEND_API_KEY=
# Optional overrides; these are the defaults.
GRADUSIQ_REPORT_TO=gradus@gradusiq.com
GRADUSIQ_REPORT_FROM="GradusIQ Reports <reports@gradusiq.com>"

# Optional role-based OpenRouter model overrides.
# Leave blank to use the central defaults in GradusIQ_career/ai/model_config.py.
GRADUSIQ_MODEL_ORCHESTRATOR=
# GRADUSIQ_MODEL_CAREER and GRADUSIQ_MODEL_ACADEMIC already default to the
# validated deepseek/deepseek-r1-0528 in model_config.py; only set these if
# overriding that default.
GRADUSIQ_MODEL_CAREER=
GRADUSIQ_MODEL_ACADEMIC=
GRADUSIQ_MODEL_PARSING=
GRADUSIQ_MODEL_CHAT=
GRADUSIQ_MODEL_REPORT=
