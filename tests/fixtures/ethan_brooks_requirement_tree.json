      "coursedog_rule_id": "pi5Mxbgo",
      "parent_group_id": null,
      "name": "Engineering Leadership (6 Credit Hours)",
      "group_type": "enumerated_at_least_n",
      "n_required": 2,
      "credit_hours_required": 6,
      "notes_html": "<p data-indent=\"1\">Students who are also enrolled in a major or minor program in the Cox School of Business may request leadership courses from these programs to substitute for the Computer Science leadership courses. These requests must be approved by the Computer Science Department. Other courses at the 3000 level or above may be petitioned to meet this requirement with prior approval by adviser. CS courses used to meet this requirement may not also meet a CS elective requirement.</p>",
      "requires_manual_definition": false,
      "created_at": "2026-08-19T17:59:26.633744+00:00",
      "updated_at": "2026-08-19T17:59:26.633744+00:00",
      "rule_source": "coursedog"
    },
    {
      "id": "657e31db-4498-4ad3-88d6-0f29917dad3f",
      "program_id": "beed8b0a-5843-472f-b554-d1bb02f025a2",
      "catalog_year": "2026-2027",
      "coursedog_rule_id": "ugGrn4NL",
      "parent_group_id": null,
      "name": "Advanced Major Electives (3-5 Credit Hours)",
      "group_type": "freeform",
      "n_required": null,
      "credit_hours_required": 3,
      "notes_html": "<p data-indent=\"1\"> Students must complete advanced major electives in Computer Science courses numbered 4000 or above as approved by the adviser. CS 4340 may not be used to meet this requirement.</p><p data-indent=\"1\">Note: Students who take CS 5315 to fulfill the Lyle EDGE Leadership and Mentoring requirements are required to take 3 credits of advanced major electives. All other students must take 5 credits of advanced major electives. Students may petition to count up to 6 credit hours of Lyle courses from other departments numbered 4000 or above toward advanced major electives with advisor approval</p>",
      "requires_manual_definition": true,
